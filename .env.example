# Copy to .env and change the password. .env is ignored by git; never commit it.
POSTGRES_USER=p7
POSTGRES_PASSWORD=change-me
POSTGRES_DB=p7
# 5433, not 5432, so it cannot clash with a PostgreSQL installed on this computer
POSTGRES_PORT=5433
# Answer layer (P7-25). Fill in your own values in .env; never commit them.
LLM_PROVIDER=
LLM_BASE_URL=
LLM_MODEL=
LLM_API_KEY=
# P7-30: how figures are ranked: text (default), image (CLIP on the figure picture) or joint (both, fused)
RETRIEVAL_MODE=text
# P7-35 login. JWT_SECRET signs the login tokens: make it long and random, e.g. the output of
#   python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET=
# true when the site is served over HTTPS (deployed); false for http://localhost
COOKIE_SECURE=false
